{
  "expo": {
    "name": "Budkin",
    "slug": "babybuddy-mobile",
    "owner": "cheekybugga",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "budkin",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.karellievens.budkin"
    },
    "android": {
      "package": "dev.karellievens.budkin",
      "adaptiveIcon": {
        "backgroundColor": "#F6EDE3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F6EDE3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#16110E"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Budkin to access your photos so you can set a child's picture.",
          "cameraPermission": "Allow Budkin to use the camera so you can take a child's picture."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "Status",
              "label": "Budkin",
              "minWidth": "110dp",
              "minHeight": "180dp",
              "targetCellWidth": 2,
              "targetCellHeight": 3,
              "resizeMode": "horizontal|vertical",
              "description": "Baby status + quick log",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "Nap",
              "label": "Nap timer",
              "minWidth": "110dp",
              "minHeight": "40dp",
              "targetCellWidth": 2,
              "targetCellHeight": 1,
              "resizeMode": "horizontal|vertical",
              "description": "Start / stop a nap",
              "previewImage": "./assets/images/icon.png",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "timers"
        }
      ],
      "expo-background-task",
      "./plugins/withQuickLogShortcuts"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "efe23cad-6a68-4669-81c6-613b97d4cbbe"
      }
    }
  }
}
